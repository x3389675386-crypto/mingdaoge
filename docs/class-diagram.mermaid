%% 明道阁 Auth · 数据模型关系类图

classDiagram
    class Profile {
        +uuid id  「PK, =auth.users.id」
        +text guest_id  «UNIQUE»
        +text nickname
        +text chat_guest_id  「客服='admin'」
        +text role  «user/admin/agent»
        +timestamptz created_at
    }
    class ChatMessages {
        +bigint id
        +text conversation_id
        +text sender_id   «=guest_id»
        +text receiver_id «=guest_id»
        +text content
        +text type
        +boolean is_read
    }
    class ForumPosts {
        +bigint id
        +text guest_id
        +text title
        +text content
    }
    class ForumComments {
        +bigint id
        +bigint post_id
        +text guest_id
        +text content
    }
    class Reviews {
        +bigint id
        +text guest_id
        +text content
    }
    class Messages {
        +bigint id
        +text guest_id
        +text content
    }
    class AuthContext {
        +getMyGuestId() string
        +signUp() / signInPassword()
        +signInOtp() / verifyOtp()
        +profile: Profile
    }
    class ChatContext {
        +myId: string
        +sendMessage()
        +getConversations()
    }

    Profile "1" --> "0..*" ChatMessages : guest_id = sender_id / receiver_id
    Profile "1" --> "0..*" ForumPosts   : guest_id
    Profile "1" --> "0..*" ForumComments: guest_id
    Profile "1" --> "0..*" Reviews      : guest_id
    Profile "1" --> "0..*" Messages     : guest_id
    AuthContext "1" --> "1" Profile : 载入/绑定
    AuthContext "1" --> "1" ChatContext : 提供 getMyGuestId()
    ChatContext "1" --> "0..*" ChatMessages : RPC 读写
